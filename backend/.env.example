APP_NAME=SoftiBridge API
APP_ENV=development
DEBUG=true
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://softi_user:softi_pass@localhost:5432/softibridge
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CLERK_ENABLED=true
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=
CLERK_API_URL=https://api.clerk.com
EA_HMAC_SECRET=change-me-ea
# Telegram Bot (@softibridge)
TELEGRAM_BOT_USERNAME=@softibridge
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_SUPER_CHAT_ID=
TELEGRAM_ADMIN_ALERTS_CHAT_ID=
TELEGRAM_SUPPORT_CHAT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_PORTAL_RETURN_URL=https://app.softibridge.com/billing
STRIPE_PUBLISHABLE_KEY=
STRIPE_SUCCESS_URL=https://softibridge.com/success
STRIPE_CANCEL_URL=https://softibridge.com/cancel
DEFAULT_CURRENCY=EUR
INVOICE_ISSUER_NAME=SoftiBridge
INVOICE_ISSUER_COUNTRY=IT
INVOICE_ISSUER_VAT_ID=
INVOICE_OUTPUT_DIR=./generated_invoices
BILLING_INVOICE_SERIES=A
BANK_ACCOUNT_NAME=
BANK_NAME=
BANK_IBAN=
BANK_BIC_SWIFT=
BANK_PAYMENT_REASON_TEMPLATE=SOFTIBRIDGE {invoice_number}
USDT_TRON_WALLET_ADDRESS=
USDT_TRON_NETWORK_LABEL=TRC20
USDT_PRICE_BUFFER_PCT=1.0
MANUAL_PAYMENT_PROOFS_DIR=./manual_payment_proofs
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SoftiBridge
SMTP_USE_TLS=true
DOWNLOADS_DIR=./downloads
SOFTIBRIDGE_FILE_BRIDGE_BASE=
# Multi-tenant: il backend NON scrive cmd_queue.txt in prod (lo fa il sidecar sul VPS client).
# Mettere true SOLO per dev locale single-tenant.
SOFTIBRIDGE_BRIDGE_FILE_LEGACY=false

# BYO Telegram bot — base URL pubblico del backend (HTTPS) per setWebhook dei bot client
TELEGRAM_WEBHOOK_BASE_URL=https://api.softibridge.com
# Fernet 32-byte url-safe base64 key per cifrare i token bot dei client a riposo.
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TELEGRAM_TOKEN_ENC_KEY=
